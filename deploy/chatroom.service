# Chatroom systemd unit（由 deploy/install.sh 替换 __PREFIX__/__HOST__/__PORT__/__USER__ 占位符）
[Unit]
Description=Chatroom (FastAPI chat server)
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__PREFIX__
ExecStart=__PREFIX__/venv/bin/uvicorn app.main:app --host __HOST__ --port __PORT__
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
